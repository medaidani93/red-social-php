                    <p style="color: #8e8e8e; font-size: 0.9rem;">No se encontraron usuarios con ese nombre.</p>
                <?php else: ?>
                    <ul class="user-list">
                        <?php foreach ($results as $u): ?>
                            <?php $yaEsAmigo = UserRepository::isFriend($_SESSION['user']['id'], $u['id']); ?>
