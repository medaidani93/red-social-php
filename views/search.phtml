                                <span class="user-name"><?= htmlspecialchars($u['username']) ?></span>
                                <?php if ($yaEsAmigo): ?>
                                    <span class="already-friend">✓ Amigo</span>
                                <?php else: ?>
                                    <a href="index.php?c=user&action=addFriend&id=<?= $u['id'] ?>&q=<?= urlencode($_GET['q']) ?>" class="btn-add">Añadir</a>
